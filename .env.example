# Número de WhatsApp en formato internacional sin "+" ni espacios (ej: 5491112345678)
# Configurar en Vercel: Settings -> Environment Variables (Development / Preview / Production)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000

# ID del Pixel de Meta / Facebook (ej: 123456789012345)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
